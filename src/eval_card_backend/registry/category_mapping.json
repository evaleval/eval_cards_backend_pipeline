      },
      {
        "category": "multimodal",
        "patterns": ["vision", "visual", "image", "multimodal", "audio"]
      },
      {
        "category": "linguistic_core",
        "patterns": [
          "language", "linguistic", "grammar", "instruction following",
          "instruction-following"
        ]
      },
      {
