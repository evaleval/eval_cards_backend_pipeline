{
  "category_version": "2.0",
  "categories": [
    "agentic", "applied_reasoning", "commonsense_reasoning", "finance",
    "general", "hallucination", "humanities_and_social_sciences",
    "knowledge", "law", "linguistic_core", "logical_reasoning",
    "mathematics", "multimodal", "natural_sciences", "other",
    "robustness", "safety", "software_engineering"
  ],
  "default_category": "general",
  "match_mode": "case_insensitive_substring",
  "priority_order": ["domains", "tasks", "tags"],
  "_source_of_truth": "Curators ship benchmark→categories[] mapping in temp_registry_override/categorized.json; classify_benchmark looks up by display_name first. These pattern-based rules apply only when the display name isn't present in categorized.json.",
  "rules": {
    "domains": [
      {
        "category": "safety",
        "patterns": [
          "safety", "harm", "toxic", "bias", "fairness", "jailbreak",
          "alignment", "redteam", "red-team", "red team", "ethic"
        ]
      },
      {
        "category": "hallucination",
        "patterns": ["hallucination", "factual error", "factuality"]
      },
      {
        "category": "agentic",
        "patterns": [
          "agentic", "agent", "tool-use", "tool_use", "tool use",
          "autonomy", "autonomous", "browse", "browsing"
        ]
      },
      {
        "category": "software_engineering",
        "patterns": [
          "code", "coding", "programming", "competitive programming",
          "software", "swe-bench"
        ]
      },
      {
        "category": "mathematics",
        "patterns": [
          "math", "mathematics", "arithmetic", "theorem", "proof",
          "calculus", "algebra"
        ]
      },
      {
        "category": "logical_reasoning",
        "patterns": ["logic", "logical", "reasoning"]
      },
      {
        "category": "commonsense_reasoning",
        "patterns": ["common sense", "commonsense", "intuitive"]
      },
      {
        "category": "natural_sciences",
        "patterns": [
